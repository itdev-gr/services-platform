---
// Οι διευθύνσεις των υπηρεσιών – αντικατέστησέ τις με τις πραγματικές URLs
const services = [
  {
    id: "sales-guide",
    icon: "target",
    title: "Οδηγός Στρατηγικής Πωλήσεων",
    description: "Επίλεξε τύπο επιχείρησης για καθοδήγηση",
    url: "https://sales-esoteriko-categories.vercel.app/",
  },
  {
    id: "keyword-planner",
    icon: "search",
    title: "Ανακαλύψτε Ευκαιρίες Λέξεων-Κλειδιών",
    description: "Εισάγετε μια λέξη-κλειδί για να δείτε τον όγκο αναζητήσεων",
    url: "https://keyword-planner-green.vercel.app/",
  },
  {
    id: "proposal",
    icon: "document",
    title: "Proposal",
    description: "Δημιουργία και διαχείριση προτάσεων για πελάτες και έργα.",
    url: "https://offer-system-eta.vercel.app/login",
  },
  {
    id: "proforma",
    icon: "file",
    title: "Proforma",
    description: "Προτεινόμενα τιμολόγια και εκτιμήσεις για τις υπηρεσίες σας.",
    url: "https://quotation-proforma.vercel.app/",
  },
  {
    id: "income-expenses",
    icon: "chart",
    title: "Income / Expenses",
    description: "Παρακολούθηση εσόδων και δαπανών με σαφή αναφορές.",
    url: "https://income-expenses-five.vercel.app/login",
  },
  {
    id: "associate-finder",
    icon: "users",
    title: "Associate Finder",
    description: "Εντοπισμός και διαχείριση συνεργατών και συνεργαζόμενων.",
    url: "https://inhouse-assosiate-finder.vercel.app/",
  },
  {
    id: "tba-1",
    icon: "clock",
    title: "TBA",
    description: "Σε εξέλιξη.",
    url: "#",
  },
  {
    id: "tba-2",
    icon: "clock",
    title: "TBA",
    description: "Σε εξέλιξη.",
    url: "#",
  },
];

---

<html lang="el">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Οι υπηρεσίες μας | IT Dev Digital Agency</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page">
      <header class="header">
        <img src="/images/itdevnewlogo.svg" alt="IT Dev Digital Agency" class="logo" width="280" height="88" />
      </header>

      <main class="main">
        <section class="services-section">
          <div class="services-grid">
            {services.map((service) => (
              <article class="card">
                <div class="card-icon" aria-hidden="true">
                  <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    {service.icon === "document" && (
                      <>
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                        <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" />
                      </>
                    )}
                    {service.icon === "file" && (
                      <>
                        <path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z" />
                        <path d="M13 2v7h7" />
                      </>
                    )}
                    {service.icon === "chart" && (
                      <path d="M18 20V10M12 20V4M6 20v-6" />
                    )}
                    {service.icon === "users" && (
                      <>
                        <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" />
                      </>
                    )}
                    {service.icon === "clock" && (
                      <>
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 6v6l4 2" />
                      </>
                    )}
                    {service.icon === "target" && (
                      <>
                        <circle cx="12" cy="12" r="10" />
                        <circle cx="12" cy="12" r="6" />
                        <circle cx="12" cy="12" r="2" />
                      </>
                    )}
                    {service.icon === "search" && (
                      <>
                        <circle cx="11" cy="11" r="8" />
                        <path d="M21 21l-4.35-4.35" />
                      </>
                    )}
                  </svg>
                </div>
                <h2 class="card-title">{service.title}</h2>
                <p class="card-description">{service.description}</p>
                <a href={service.url} class="card-link" target="_blank" rel="noopener noreferrer">
                  Δες περισσότερα →
                </a>
              </article>
            ))}
          </div>
        </section>
      </main>
    </div>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-family: "DM Sans", system-ui, sans-serif;
    background: #f5f5f7;
    color: #1a1a1a;
    min-height: 100%;
  }

  body {
    margin: 0;
    min-height: 100vh;
  }
</style>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .header {
    background: #1a1a1f;
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .logo {
    display: block;
    height: auto;
    max-width: 280px;
    width: 100%;
  }

  .main {
    flex: 1;
    padding: 3rem 1.5rem 4rem;
  }

  .services-section {
    max-width: 1100px;
    margin: 0 auto;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .card-icon {
    width: 56px;
    height: 56px;
    background: #2dd4bf;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

    .icon-svg {
    width: 28px;
    height: 28px;
    color: #fff;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    color: #1a1a1a;
    line-height: 1.3;
  }

  .card-description {
    font-size: 0.9375rem;
    color: #4b5563;
    line-height: 1.6;
    margin: 0 0 1.25rem;
    flex: 1;
  }

  .card-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #0d9488;
    text-decoration: none;
    transition: color 0.2s;
  }

  .card-link:hover {
    color: #0f766e;
    text-decoration: underline;
  }

  .card-link:focus-visible {
    outline: 2px solid #2dd4bf;
    outline-offset: 2px;
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }

    .card {
      padding: 2.25rem;
    }
  }
</style>
